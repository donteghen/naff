# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string (the free M0 tier is enough). Allow 0.0.0.0/0 in Atlas for Vercel.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/naff?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Hosts (placeholders: replace example.com with your domain)
# The app is chosen by the host name: driver.<domain> → driver app, panel.<domain> → admin panel,
# anything else → customer site. Locally: localhost:3000, driver.localhost:3000, panel.localhost:3000.
# ---------------------------------------------------------------------------
SITE_URL="http://localhost:3000"            # e.g. https://example.com — used in tracking links
PANEL_URL="http://panel.localhost:3000"     # e.g. https://panel.example.com — used in alert emails
DRIVER_URL="http://driver.localhost:3000"   # e.g. https://driver.example.com — used in driver notifications and WhatsApp job details

# ---------------------------------------------------------------------------
# Driver job notifications (ntfy). Drivers subscribe in the ntfy app (setup on each driver's page).
# ---------------------------------------------------------------------------
NTFY_URL="https://ntfy.sh"
NTFY_TOKEN=""                # empty on the free tier; set it after buying a plan on ntfy.sh

# ---------------------------------------------------------------------------
# Live admin alerts (Ably). Leave empty to switch live alerts off.
# ---------------------------------------------------------------------------
ABLY_API_KEY=""
# Only used when ABLY_API_KEY is empty: "true" makes the panel reload its data every REFRESH_SECONDS.
FALLBACK_TO_REFRESH="false"
REFRESH_SECONDS="15"

# ---------------------------------------------------------------------------
# Email (SMTP): customer PIN reset and new request alerts to admins. Leave empty to switch email off.
# ---------------------------------------------------------------------------
SMTP_HOST=""                 # e.g. smtp.gmail.com
SMTP_PORT="587"              # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=""                 # full mailbox address, also used as the sender address
SMTP_PASSWORD=""             # password or app password
SMTP_FROM_NAME="NAFF"

# ---------------------------------------------------------------------------
# Limits (defaults shown)
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILS="5"              # failed logins per phone before blocking…
LOGIN_WINDOW_MINUTES="15"        # …within this many minutes
PIN_RESET_MAX="3"                # PIN reset emails per phone…
PIN_RESET_WINDOW_MINUTES="60"    # …within this many minutes
TEMP_PIN_TTL_MINUTES="30"        # lifetime of an emailed temporary PIN
DELIVERY_CODE_MAX_ATTEMPTS="3"   # wrong delivery codes before the entry locks

# ---------------------------------------------------------------------------
# Debugging: one terminal line per server action and page load (PINs and codes are masked).
# ---------------------------------------------------------------------------
DEBUG_LOG="false"
